# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/
.claude/
.thesis/
.reference/
.planning/

# Local working tickets (mattpocock to-tickets, not tracked)
.scratch/

# Generated run outputs: run bundles, the runtime Triton model repository, and
# Triton's raw trace files. Bundles are mirrored from S3 for analysis; they are
# never source and never committed (CODEBASE.md §13).
/results/

# Model binaries. The artifact catalog (artifacts/catalog.json) is provenance and
# is committed; the .onnx artifacts it describes are not — they are regenerated
# from tools/modelgen and verified by digest (CODEBASE.md §11).
/artifacts/generated/

# Python tooling. uv.lock is committed: pinned dependency versions are part of
# reproducibility, not local state.
__pycache__/
.venv/
.pytest_cache/
